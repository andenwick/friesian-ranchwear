{
  "name": "friesian-ranchwear",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "node scripts/run-integration-tests.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "reconcile:report": "node scripts/report-reconciliation.mjs",
    "verify:restore": "node scripts/verify-backup-restore.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "check": "npm run test && npm run audit:prod && npm run build"
  },
  "overrides": {
    "@auth/core": "0.41.3"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@prisma/client": "^5.22.0",
    "@sentry/nextjs": "10.74.0",
    "@stripe/react-stripe-js": "^3.2.0",
    "@stripe/stripe-js": "^5.5.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "googleapis": "^170.1.0",
    "gsap": "^3.15.0",
    "next": "16.3.4",
    "next-auth": "4.24.15",
    "prisma": "^5.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "stripe": "^17.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "vitest": "^4.1.10"
  }
}
